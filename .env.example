# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
PORT="3000"
NODE_ENV="development"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Meta WhatsApp Cloud API webhook verification token.
# Use the same value in Meta Developers > WhatsApp > Configuration.
META_WEBHOOK_VERIFY_TOKEN="sales_ai_crm_whatsapp_verify_2026"

# WhatsApp Cloud API credentials for sending replies after webhook verification.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Meta, Facebook, Instagram, Messenger and Lead Ads.
META_APP_ID=""
META_APP_SECRET=""
META_PAGE_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""

# Google Ads API.
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""

# YouTube channel / ads helpers.
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""

# AI creative generation providers for image and video production.
IMAGE_GENERATION_PROVIDER=""
IMAGE_GENERATION_API_KEY=""
VIDEO_GENERATION_PROVIDER=""
VIDEO_GENERATION_API_KEY=""

# Payment provider. Fill according to the selected gateway.
PAYMENT_PROVIDER=""
PAYMENT_PUBLIC_KEY=""
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# Dominican Republic electronic invoice / DGII e-CF provider.
DGII_ECF_ENVIRONMENT="demo"
DGII_ECF_CERTIFICATE_PATH=""
DGII_ECF_CERTIFICATE_PASSWORD=""
DGII_ECF_ISSUER_RNC=""
DGII_ECF_PROVIDER_API_KEY=""

# Owner notifications. Used when WhatsApp/email providers are connected.
OWNER_NOTIFICATION_WHATSAPP=""
OWNER_NOTIFICATION_EMAIL=""
