# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_FALLBACK_MODELS="gemini-2.5-flash,gemini-2.0-flash,gemini-2.0-flash-lite,gemini-1.5-flash,gemini-1.5-flash-8b"
GEMINI_MODEL_RETRY_DELAY_MS="120000"
AGENT_KNOWLEDGE_MAX_CHARS="48000"
PORT="3000"
NODE_ENV="development"
DEPLOYMENT_MODE="production"
VITE_DEPLOYMENT_MODE="production"

# Real CRM login. Required in Render production so the dashboard does not open as demo.
ADMIN_EMAIL="admin@inteca.com.do"
ADMIN_PASSWORD="cambia_esta_contrasena_privada"
ADMIN_NAME="Luis Ramirez"
ADMIN_ORGANIZATION="INTECA SRL"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Supabase persistence for real multi-company data, agent memory, audit, files and auth.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""
SUPABASE_STORAGE_BUCKET="sales-ai-crm"

# Render deployment metadata / optional automation.
RENDER_SERVICE_ID=""
RENDER_API_KEY=""
TRUST_PROXY="true"

# Meta WhatsApp Cloud API webhook verification token.
# Use the same value in Meta Developers > WhatsApp > Configuration.
META_WEBHOOK_VERIFY_TOKEN="sales_ai_crm_whatsapp_verify_2026"
META_GRAPH_API_VERSION="v22.0"

# WhatsApp Cloud API credentials for sending replies after webhook verification.
WHATSAPP_AUTO_REPLY_ENABLED="true"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Meta, Facebook, Instagram, Messenger and Lead Ads.
META_APP_ID=""
META_APP_SECRET=""
META_PAGE_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""

# Google Ads API.
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""

# YouTube channel / ads helpers.
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""

# AI creative generation providers for image and video production.
IMAGE_GENERATION_PROVIDER=""
IMAGE_GENERATION_API_KEY=""
VIDEO_GENERATION_PROVIDER=""
VIDEO_GENERATION_API_KEY=""

# Payment provider. Fill according to the selected gateway.
PAYMENT_PROVIDER=""
PAYMENT_PUBLIC_KEY=""
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# Ad payment/tokenization provider. Do not store raw card numbers in the CRM.
AD_PAYMENT_PROVIDER=""
AD_PAYMENT_PUBLIC_KEY=""
AD_PAYMENT_SECRET_KEY=""
AD_PAYMENT_WEBHOOK_SECRET=""
META_ADS_BILLING_ACCOUNT_ID=""
GOOGLE_ADS_BILLING_SETUP_ID=""

# Dominican Republic electronic invoice / DGII e-CF provider.
DGII_ECF_ENVIRONMENT="production"
DGII_ECF_CERTIFICATE_PATH=""
DGII_ECF_CERTIFICATE_PASSWORD=""
DGII_ECF_ISSUER_RNC=""
DGII_ECF_PROVIDER_API_KEY=""

# Owner notifications. Used when WhatsApp/email providers are connected.
OWNER_NOTIFICATION_WHATSAPP=""
OWNER_NOTIFICATION_EMAIL=""
