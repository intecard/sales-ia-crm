generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum ContactStatus {
  ACTIVE
  WON
  LOST
  PAUSED
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum ActivityType {
  NOTE
  TASK
  CALL
  EMAIL
  MEETING
  FOLLOW_UP
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELED
}

enum IntegrationStatus {
  NOT_CONFIGURED
  SANDBOX
  CONNECTED
  ERROR
  PAUSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model Plan {
  id             String         @id @default(cuid())
  code           String         @unique
  name           String
  monthlyPrice   Decimal        @db.Decimal(12, 2)
  annualPrice    Decimal        @db.Decimal(12, 2)
  userLimit      Int
  contactLimit   Int
  storageMbLimit Int
  aiCreditsLimit Int
  features       Json
  active         Boolean        @default(true)
  subscriptions  Subscription[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Organization {
  paymentRequests PaymentRequest[]
  id            String                  @id @default(cuid())
  name          String
  slug          String                  @unique
  status        OrganizationStatus      @default(TRIAL)
  timezone      String                  @default("America/Santo_Domingo")
  locale        String                  @default("es-DO")
  currency      String                  @default("DOP")
  logoUrl       String?
  primaryColor  String?                 @default("#4f46e5")
  settings      Json                    @default("{}")
  memberships   Membership[]
  subscriptions Subscription[]
  contacts      Contact[]
  companies     Company[]
  products      Product[]
  pipelines     Pipeline[]
  deals         Deal[]
  activities    Activity[]
  conversations Conversation[]
  payments      Payment[]
  integrations  IntegrationConnection[]
  auditLogs     AuditLog[]
  modules       ModuleInstallation[]
  usageRecords  UsageRecord[]
  aiAgents      AIAgent[]
  customFields  CustomFieldDefinition[]
  campaigns     Campaign[]
  automations   Automation[]
  documents     Document[]
  creativeContents CreativeContent[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String
  planId         String
  status         SubscriptionStatus @default(TRIALING)
  startsAt       DateTime           @default(now())
  trialEndsAt    DateTime?
  currentEndAt   DateTime?
  canceledAt     DateTime?
  provider       String?
  providerRef    String?
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           Plan               @relation(fields: [planId], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, status])
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  passwordHash    String
  name            String
  active          Boolean      @default(true)
  emailVerifiedAt DateTime?
  memberships     Membership[]
  sessions        Session[]
  auditLogs       AuditLog[]   @relation("AuditActor")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  permissions RolePermission[]
  memberships Membership[]
}

model Permission {
  id    String           @id @default(cuid())
  code  String           @unique
  name  String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Company {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  website        String?
  metadata       Json         @default("{}")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       Contact[]
  deals          Deal[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, name])
}

model Contact {
  id             String         @id @default(cuid())
  organizationId String
  companyId      String?
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  status         ContactStatus  @default(ACTIVE)
  source         String?
  ownerUserId    String?
  tags           String[]
  metadata       Json           @default("{}")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals          Deal[]
  activities     Activity[]
  conversations  Conversation[]
  payments       Payment[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, email])
  @@index([organizationId, phone])
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  sku            String?
  type           String       @default("SERVICE")
  description    String?
  price          Decimal      @db.Decimal(12, 2)
  currency       String       @default("DOP")
  active         Boolean      @default(true)
  metadata       Json         @default("{}")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals          Deal[]
  payments       Payment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId, active])
}

model Pipeline {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  isDefault      Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages         Stage[]
  deals          Deal[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Stage {
  id         String   @id @default(cuid())
  pipelineId String
  name       String
  position   Int
  color      String?
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals      Deal[]

  @@unique([pipelineId, position])
}

model Deal {
  id              String       @id @default(cuid())
  organizationId  String
  pipelineId      String
  stageId         String
  contactId       String?
  companyId       String?
  productId       String?
  title           String
  value           Decimal      @db.Decimal(12, 2)
  currency        String       @default("DOP")
  probability     Int          @default(0)
  status          DealStatus   @default(OPEN)
  expectedCloseAt DateTime?
  lostReason      String?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline        Pipeline     @relation(fields: [pipelineId], references: [id])
  stage           Stage        @relation(fields: [stageId], references: [id])
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  product         Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  activities      Activity[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([pipelineId, stageId])
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  contactId      String?
  dealId         String?
  assignedUserId String?
  type           ActivityType
  title          String
  description    String?
  dueAt          DateTime?
  completedAt    DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, dueAt])
}

model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  contactId      String?
  channel        String
  externalRef    String?
  status         String       @default("OPEN")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages       Message[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, channel])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  content        String
  status         String           @default("PENDING")
  externalRef    String?
  metadata       Json             @default("{}")
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

model IntegrationConnection {
  id              String            @id @default(cuid())
  organizationId  String
  provider        String
  status          IntegrationStatus @default(NOT_CONFIGURED)
  encryptedConfig String?
  lastError       String?
  lastCheckedAt   DateTime?
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([organizationId, provider])
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  contactId      String?
  productId      String?
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("DOP")
  status         PaymentStatus @default(PENDING)
  provider       String
  providerRef    String?
  idempotencyKey String
  metadata       Json          @default("{}")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
}

model AIAgent {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  role           String
  active         Boolean         @default(true)
  systemPrompt   String
  settings       Json            @default("{}")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  promptVersions PromptVersion[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, active])
}

model PromptVersion {
  id        String   @id @default(cuid())
  agentId   String
  version   Int
  prompt    String
  active    Boolean  @default(false)
  agent     AIAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([agentId, version])
}

model ModuleInstallation {
  id             String       @id @default(cuid())
  organizationId String
  moduleCode     String
  enabled        Boolean      @default(true)
  settings       Json         @default("{}")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleCode])
}

model UsageRecord {
  id             String       @id @default(cuid())
  organizationId String
  metric         String
  quantity       Int          @default(1)
  period         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, metric, period])
}

model CustomFieldDefinition {
  id             String       @id @default(cuid())
  organizationId String
  entityType     String
  key            String
  label          String
  fieldType      String
  required       Boolean      @default(false)
  options        Json         @default("[]")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entityType, key])
}

model Campaign {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  channel        String
  status         String       @default("DRAFT")
  audience       Json         @default("{}")
  content        Json         @default("{}")
  scheduledAt    DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
}

model Automation {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  trigger        Json
  actions        Json
  active         Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, active])
}

model Document {
  id             String       @id @default(cuid())
  organizationId String
  ownerEntity    String?
  ownerEntityId  String?
  name           String
  mimeType       String
  sizeBytes      Int
  content        Bytes?
  storageKey     String       @unique
  checksum       String
  status         String       @default("PENDING_SCAN")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, ownerEntity, ownerEntityId])
}

model CreativeContent {
  id               String       @id @default(cuid())
  organizationId   String
  type             String
  format           String
  title            String
  subtitle         String?
  body             String
  callToAction     String?
  status           String       @default("DRAFT")
  sourceName       String?
  sourceVerified   Boolean      @default(false)
  consentConfirmed Boolean      @default(false)
  factsConfirmed   Boolean      @default(false)
  brandSettings    Json         @default("{}")
  reviewNotes      String?
  approvedBy       String?
  approvedAt       DateTime?
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, type])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  entityType     String?
  entityId       String?
  ipAddress      String?
  userAgent      String?
  metadata       Json          @default("{}")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
}

model PaymentRequest {
  id             String @id @default(cuid())
  organizationId String
  contactId      String?
  token          String @unique
  amount         Decimal @db.Decimal(12,2)
  currency       String
  description    String
  status         String @default("PENDING")
  expiresAt      DateTime
  paymentId      String?
  proofMeta      Json @default("{}")
  organization   Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([organizationId,status])
}

model ChannelEvent {
 id String @id @default(cuid())
 organizationId String
 provider String
 externalId String
 payload Json
 status String @default("PENDING")
 conversationId String?
 error String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([organizationId, provider, externalId])
 @@index([status, createdAt])
}
